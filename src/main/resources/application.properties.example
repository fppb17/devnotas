# ============================================
# Configuración general de la aplicación
# ============================================
spring.application.name=notas-backend
server.port=8080

# ============================================
# Base de datos PostgreSQL (R2DBC)
# ============================================
spring.r2dbc.url=${DB_URL}
spring.r2dbc.username=${DB_USERNAME}
spring.r2dbc.password=${DB_PASSWORD}

spring.r2dbc.pool.initial-size=5
spring.r2dbc.pool.max-size=20

# ============================================
# Azure Blob Storage
# ============================================
azure.storage.connection-string=${AZURE_STORAGE_CONNECTION_STRING}
azure.storage.container.public-profiles=public-profiles
azure.storage.container.public-media=public-media
azure.storage.container.private-uploads=private-uploads

# ============================================
# Seguridad JWT
# ============================================
jwt.secret=${JWT_SECRET}
jwt.expiration-ms=86400000
jwt.refresh-expiration-ms=604800000

# ============================================
# Logs
# ============================================
logging.level.com.notas.backend=DEBUG
logging.level.org.springframework.r2dbc=DEBUG